# Application runtime
APP_ENV=development
APP_NAME=AI Travel Planner API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Comma-free JSON array of allowed browser origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
APP_TIMEZONE=Asia/Kolkata

# Server-side location verification (Geoapify)
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_SECONDS=8

# File logging (relative paths are resolved from the repository root)
LOG_DIRECTORY=logs

# PostgreSQL
# DATABASE_URL must use SQLAlchemy's asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_travel_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_travel_planner
POSTGRES_PORT=5432

# Authentication
# Generate a unique, high-entropy value for every environment.
JWT_SECRET_KEY=replace-with-a-random-32-byte-minimum-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI itinerary generation
# Create a key in Google AI Studio. Leave empty to disable generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Google Maps Platform (enable Places API (New) for this server-side key)
GOOGLE_PLACES_API_KEY=
# Optional fallback; GOOGLE_PLACES_API_KEY takes precedence when both are set.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=8

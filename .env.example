# Application runtime
APP_ENV=development
APP_NAME=AI Travel Planner API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Comma-free JSON array of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# File logging (relative paths are resolved from the repository root)
LOG_DIRECTORY=logs

# PostgreSQL
# DATABASE_URL must use SQLAlchemy's asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_travel_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_travel_planner
POSTGRES_PORT=5432
